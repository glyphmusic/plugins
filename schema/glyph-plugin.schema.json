{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/glyphmusic/plugins/main/schema/glyph-plugin.schema.json",
  "title": "Glyph plugin manifest",
  "type": "object",
  "required": ["id", "name", "version", "kind"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "minLength": 2, "maxLength": 40 },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "version": { "type": "string", "description": "Semantic version, e.g. 1.0.0" },
    "author": { "type": "string", "maxLength": 40 },
    "description": { "type": "string", "maxLength": 200 },
    "license": { "type": "string", "maxLength": 40 },
    "min_app": { "type": "string", "description": "Oldest Glyph version the plugin works with" },
    "kind": { "enum": ["theme"] },
    "theme": {
      "type": "object",
      "required": ["accent"],
      "properties": {
        "accent": { "$ref": "#/$defs/colour" },
        "glow": { "type": "array", "items": { "$ref": "#/$defs/colour" }, "minItems": 3, "maxItems": 3 },
        "base": { "$ref": "#/$defs/colour", "description": "Near black: each channel at most #24" }
      },
      "additionalProperties": false
    }
  },
  "if": { "properties": { "kind": { "const": "theme" } } },
  "then": { "required": ["theme"] },
  "$defs": {
    "colour": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
  }
}
